@@ -0,0 +1,81 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use App\Http\Resources\InvoiceResource;
+use App\Models\Invoice;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Validation\ValidationException;
+
+/**
+ * Modul 5 (bagian invoice): daftar, detail, batalkan.
+ * Hak akses: permission "manage invoices" (dipasang di routes).
+ */
+class InvoiceController extends Controller
+{
+    private const WITH = ['registration.program', 'payments'];
+
+    public function index(Request $request)
+    {
+        $request->validate([
+            'status' => ['nullable', 'in:unpaid,paid,void'],
+            'q' => ['nullable', 'string', 'max:100'],
+            'per_page' => ['nullable', 'integer', 'min:1', 'max:100'],
+        ]);
+
+        $query = Invoice::query()->with(self::WITH);
+
+        if ($request->filled('status')) {
+            $query->where('status', $request->string('status')->toString());
+        }
+        if ($request->filled('q')) {
+            $q = '%'.$request->string('q').'%';
+            $query->where(fn ($w) => $w
+                ->where('number', 'like', $q)
+                ->orWhereHas('registration', fn ($r) => $r->where('student_name', 'like', $q)->orWhere('parent_name', 'like', $q)));
+        }
+
+        return InvoiceResource::collection(
+            $query->orderByDesc('issued_at')->orderByDesc('id')->paginate($request->integer('per_page', 25))
+        );
+    }
+
+    public function show(Invoice $invoice)
+    {
+        return new InvoiceResource($invoice->load(self::WITH));
+    }
+
+    /**
+     * Batalkan invoice; pendaftaran kembali ke antrian verifikasi agar bisa disetujui ulang (invoice baru).
+     */
+    public function void(Request $request, Invoice $invoice)
+    {
+        $data = $request->validate([
+            'reason' => ['required', 'string', 'max:500'],
+        ]);
+
+        if ($invoice->status !== 'unpaid') {
+            throw ValidationException::withMessages([
+                'status' => ['Hanya invoice yang belum lunas yang dapat dibatalkan.'],
+            ]);
+        }
+        if ($invoice->payments()->whereIn('status', ['pending', 'confirmed'])->exists()) {
+            throw ValidationException::withMessages([
+                'invoice' => ['Tolak dulu pembayaran yang menunggu konfirmasi sebelum membatalkan invoice.'],
+            ]);
+        }
+
+        DB::transaction(function () use ($invoice, $data) {
+            $invoice->update(['status' => 'void', 'void_reason' => $data['reason']]);
+            $invoice->registration->update([
+                'status' => 'menunggu_verifikasi',
+                'verified_by' => null,
+                'verified_at' => null,
+            ]);
+        });
+
+        return new InvoiceResource($invoice->fresh(self::WITH));
+    }
+}
diff --git a/after-schola/app/Http/Controllers/Api/PaymentController.php b/after-schola/app/Http/Controllers/Api/PaymentController.php
new file mode 100644
index 0000000..de2276c
--- /dev/null
+++ b/after-schola/app/Http/Controllers/Api/PaymentController.php
@@ -0,0 +1,95 @@
+<?php
+
+namespace App\Http\Controllers\Api;
+
+use App\Http\Controllers\Controller;
+use App\Http\Resources\PaymentResource;
+use App\Models\Invoice;
+use App\Models\Payment;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Str;
+use Illuminate\Validation\ValidationException;
+
+/**
+ * Modul 5 (bagian pembayaran). Mencatat pembayaran = permission "manage invoices";
+ * mengonfirmasi / menolak = permission "confirm payments" (dipasang di routes).
+ * Nominal selalu = nominal invoice (lunas sekaligus).
+ * TODO(nanti): cicilan — tabel sudah mendukung banyak pembayaran per invoice (PRD KEU-11, [v3]).
+ */
+class PaymentController extends Controller
+{
+    public function store(Request $request, Invoice $invoice)
+    {
+        $data = $request->validate([
+            'method' => ['required', 'in:transfer,tunai'],
+            'paid_date' => ['required', 'date', 'before_or_equal:today'],
+            'proof' => ['nullable', 'required_if:method,transfer', 'image', 'mimes:jpeg,jpg,png', 'max:5120'],
+        ]);
+
+        if ($invoice->status !== 'unpaid') {
+            throw ValidationException::withMessages(['invoice' => ['Invoice ini tidak dapat menerima pembayaran.']]);
+        }
+        if ($invoice->payments()->whereIn('status', ['pending', 'confirmed'])->exists()) {
+            throw ValidationException::withMessages(['invoice' => ['Invoice ini sudah punya pembayaran yang menunggu atau sudah dikonfirmasi.']]);
+        }
+
+        $path = null;
+        if ($request->hasFile('proof')) {
+            $file = $request->file('proof');
+            // Nama hasil generate, bukan nama asli dari client.
+            $path = $file->storeAs('payment-proofs', Str::uuid().'.'.$file->extension(), 'public');
+        }
+
+        $payment = Payment::create([
+            'invoice_id' => $invoice->id,
+            'amount' => $invoice->amount,
+            'method' => $data['method'],
+            'paid_date' => $data['paid_date'],
+            'proof_path' => $path,
+            'status' => 'pending',
+            'recorded_by' => $request->user()->id,
+        ]);
+
+        return (new PaymentResource($payment))->response()->setStatusCode(201);
+    }
+
+    public function confirm(Request $request, Payment $payment)
+    {
+        $this->ensurePending($payment);
+
+        DB::transaction(function () use ($payment, $request) {
+            $payment->update([
+                'status' => 'confirmed',
+                'confirmed_by' => $request->user()->id,
+                'confirmed_at' => now(),
+            ]);
+
+            $invoice = $payment->invoice;
+            if ($invoice->payments()->where('status', 'confirmed')->sum('amount') >= $invoice->amount) {
+                $invoice->update(['status' => 'paid', 'paid_at' => now()]);
+            }
+        });
+
+        return new PaymentResource($payment->fresh());
+    }
+
+    public function reject(Request $request, Payment $payment)
+    {
+        $data = $request->validate([
+            'reason' => ['required', 'string', 'max:500'],
+        ]);
+        $this->ensurePending($payment);
+
+        $payment->update(['status' => 'rejected', 'reject_reason' => $data['reason']]);
+
+        return new PaymentResource($payment->fresh());
+    }
+
+    private function ensurePending(Payment $payment): void
+    {
+        if ($payment->status !== 'pending') {
+            throw ValidationException::withMessages(['status' => ['Pembayaran ini sudah diproses.']]);
+        }
+    }
+}
