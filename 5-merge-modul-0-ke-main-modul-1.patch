+++ b/after-schola/tests/Feature/BranchTest.php
@@ -0,0 +1,136 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\Branch;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Laravel\Sanctum\Sanctum;
+use Tests\Concerns\MakesBranchFixtures;
+use Tests\TestCase;
+
+class BranchTest extends TestCase
+{
+    use MakesBranchFixtures, RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $this->seedRoles();
+    }
+
+    public function test_guest_gets_401(): void
+    {
+        $this->getJson('/api/branches')->assertStatus(401);
+    }
+
+    public function test_user_without_manage_branches_permission_gets_403(): void
+    {
+        foreach (['trainer', 'finance', 'parent'] as $role) {
+            Sanctum::actingAs($this->makeStaff($role, 'all'));
+            $this->getJson('/api/branches')->assertStatus(403);
+            $this->postJson('/api/branches', ['name' => 'X', 'code' => 'XXX'])->assertStatus(403);
+        }
+    }
+
+    public function test_management_without_function_permission_gets_403_but_users_admin_can_list(): void
+    {
+        $bdg = $this->makeBranch();
+        Sanctum::actingAs($this->makeStaff('management', 'all'));
+        $this->getJson('/api/branches')->assertStatus(403);
+
+        // Form user perlu daftar cabang: manage users cukup untuk membaca, bukan menulis.
+        Sanctum::actingAs($this->makeStaff('management', 'all', [], ['manage users']));
+        $this->getJson('/api/branches')->assertOk()->assertJsonCount(1, 'data');
+        $this->getJson("/api/branches/{$bdg->id}")->assertStatus(403);
+        $this->postJson('/api/branches', ['name' => 'X', 'code' => 'XXX'])->assertStatus(403);
+    }
+
+    public function test_all_scope_lists_every_branch(): void
+    {
+        $this->makeBranch('Cabang Bandung', 'BDG');
+        $this->makeBranch('Cabang Jakarta', 'JKT');
+        Sanctum::actingAs($this->makeStaff('management', 'all', [], ['manage branches']));
+
+        $this->getJson('/api/branches')->assertOk()->assertJsonCount(2, 'data');
+    }
+
+    public function test_assigned_scope_lists_only_own_branches(): void
+    {
+        $bdg = $this->makeBranch('Cabang Bandung', 'BDG');
+        $this->makeBranch('Cabang Jakarta', 'JKT');
+        Sanctum::actingAs($this->makeStaff('management', 'assigned', [$bdg->id], ['manage branches']));
+
+        $this->getJson('/api/branches')->assertOk()
+            ->assertJsonCount(1, 'data')
+            ->assertJsonPath('data.0.code', 'BDG');
+    }
+
+    public function test_all_scope_can_create_branch(): void
+    {
+        Sanctum::actingAs($this->makeStaff('management', 'all', [], ['manage branches']));
+
+        $this->postJson('/api/branches', ['name' => 'Cabang Bandung', 'code' => 'BDG', 'address' => 'Jl. Braga 1'])
+            ->assertStatus(201)
+            ->assertJsonPath('data.code', 'BDG')
+            ->assertJsonPath('data.is_active', true);
+
+        $this->assertDatabaseHas('branches', ['code' => 'BDG', 'name' => 'Cabang Bandung']);
+    }
+
+    public function test_assigned_scope_cannot_create_branch(): void
+    {
+        $bdg = $this->makeBranch();
+        Sanctum::actingAs($this->makeStaff('management', 'assigned', [$bdg->id], ['manage branches']));
+
+        $this->postJson('/api/branches', ['name' => 'Cabang Baru', 'code' => 'NEW'])->assertStatus(403);
+        $this->assertDatabaseMissing('branches', ['code' => 'NEW']);
+    }
+
+    public function test_create_validates_name_and_unique_code_format(): void
+    {
+        $this->makeBranch('Cabang Bandung', 'BDG');
+        Sanctum::actingAs($this->makeStaff('management', 'all', [], ['manage branches']));
+
+        $this->postJson('/api/branches', ['code' => 'JKT'])->assertStatus(422)->assertJsonValidationErrors('name');
+        $this->postJson('/api/branches', ['name' => 'Dobel', 'code' => 'BDG'])->assertStatus(422)->assertJsonValidationErrors('code');
+        $this->postJson('/api/branches', ['name' => 'Salah Format', 'code' => 'jk t!'])->assertStatus(422)->assertJsonValidationErrors('code');
+    }
+
+    public function test_show_and_update_in_scope(): void
+    {
+        $bdg = $this->makeBranch();
+        Sanctum::actingAs($this->makeStaff('management', 'assigned', [$bdg->id], ['manage branches']));
+
+        $this->getJson("/api/branches/{$bdg->id}")->assertOk()->assertJsonPath('data.name', 'Cabang Bandung');
+        $this->putJson("/api/branches/{$bdg->id}", ['name' => 'Cabang Bandung Pusat', 'code' => 'BDG'])
+            ->assertOk()
+            ->assertJsonPath('data.name', 'Cabang Bandung Pusat');
+    }
+
+    public function test_out_of_scope_branch_returns_404_not_403(): void
+    {
+        $bdg = $this->makeBranch('Cabang Bandung', 'BDG');
+        $jkt = $this->makeBranch('Cabang Jakarta', 'JKT');
+        Sanctum::actingAs($this->makeStaff('management', 'assigned', [$bdg->id], ['manage branches']));
+
+        $this->getJson("/api/branches/{$jkt->id}")->assertStatus(404);
+        // Payload kosong tetap 404 (bukan 422) agar keberadaan cabang tidak bocor.
+        $this->putJson("/api/branches/{$jkt->id}", [])->assertStatus(404);
+        $this->putJson("/api/branches/{$jkt->id}", ['name' => 'Hack', 'code' => 'JKT'])->assertStatus(404);
+        $this->assertDatabaseHas('branches', ['id' => $jkt->id, 'name' => 'Cabang Jakarta']);
+    }
+
+    public function test_branch_can_be_deactivated_and_is_never_deleted(): void
+    {
+        $bdg = $this->makeBranch();
+        Sanctum::actingAs($this->makeStaff('management', 'all', [], ['manage branches']));
+
+        $this->putJson("/api/branches/{$bdg->id}", ['name' => $bdg->name, 'code' => $bdg->code, 'is_active' => false])
+            ->assertOk()
+            ->assertJsonPath('data.is_active', false);
+
+        // MGT-04: entitas tidak dihapus permanen — tidak ada endpoint DELETE.
+        $this->deleteJson("/api/branches/{$bdg->id}")->assertStatus(405);
+        $this->assertSame(1, Branch::count());
+    }
+}
diff --git a/after-schola/tests/Feature/FunctionPermissionTest.php b/after-schola/tests/Feature/FunctionPermissionTest.php
new file mode 100644
index 0000000..e2be8d5
--- /dev/null
+++ b/after-schola/tests/Feature/FunctionPermissionTest.php
@@ -0,0 +1,97 @@
+<?php
+
+namespace Tests\Feature;
+
+use App\Models\User;
+use App\Support\FunctionPermissions;
+use Illuminate\Foundation\Testing\RefreshDatabase;
+use Illuminate\Support\Facades\Hash;
+use Laravel\Sanctum\Sanctum;
+use Spatie\Permission\Models\Permission;
+use Spatie\Permission\Models\Role;
+use Tests\Concerns\MakesBranchFixtures;
+use Tests\TestCase;
+
+class FunctionPermissionTest extends TestCase
+{
+    use MakesBranchFixtures, RefreshDatabase;
+
+    protected function setUp(): void
+    {
+        parent::setUp();
+        $this->seedRoles();
+    }
+
+    public function test_seeder_creates_every_function_permission_from_prd(): void
+    {
+        $expected = [
+            'manage programs', 'manage trial slots', 'manage leads', 'verify registrations',
+            'manage classes', 'manage schedule', 'assign trainers', 'review reports',
+            'view dashboard', 'view all attendance', 'view finance reports',
+            'manage users', 'manage branches', 'manage integrations',
+            'confirm payments', 'manage invoices', 'export trainer attendance',
+        ];
+
+        $this->assertEqualsCanonicalizing($expected, FunctionPermissions::ALL);
+        foreach ($expected as $name) {
+            $this->assertTrue(Permission::where('name', $name)->exists(), "permission '{$name}' belum di-seed");
+        }
+    }
+
+    public function test_management_role_holds_no_function_permission(): void
+    {
+        $held = Role::findByName('management')->permissions->pluck('name')->all();
+
+        $this->assertSame([], array_values(array_intersect($held, FunctionPermissions::ALL)));
+    }
+
+    public function test_finance_role_holds_finance_function_permissions(): void
+    {
+        $held = Role::findByName('finance')->permissions->pluck('name')->all();
+
+        foreach (['confirm payments', 'manage invoices', 'view finance reports', 'export trainer attendance'] as $name) {
+            $this->assertContains($name, $held);
+        }
+    }
+
+    public function test_management_user_without_function_permission_is_forbidden(): void
+    {
+        $target = $this->makeStaff('trainer', 'all');
+        Sanctum::actingAs($this->makeStaff('management', 'all'));
+
+        // Kelola user (tulis/baca detail) butuh manage users; daftar user terbuka untuk dropdown (lihat UserManagementTest).
+        $this->postJson('/api/users', ['name' => 'X'])->assertStatus(403);
+        $this->getJson("/api/users/{$target->id}")->assertStatus(403);
+        $this->putJson("/api/users/{$target->id}", ['name' => 'X'])->assertStatus(403);
+        $this->getJson('/api/branches')->assertStatus(403);
+        $this->getJson('/api/finance/aging')->assertStatus(403);
+    }
+
+    public function test_direct_function_permission_grants_exactly_that_function(): void
+    {
+        Sanctum::actingAs($this->makeStaff('management', 'all', [], ['manage users']));
+
+        $this->getJson('/api/users')->assertOk();
+        $this->getJson('/api/branches')->assertOk(); // dropdown cabang untuk form user
+        $this->postJson('/api/branches', ['name' => 'Baru', 'code' => 'NEW'])->assertStatus(403);
+        $this->getJson('/api/finance/aging')->assertStatus(403);
+    }
+
+    public function test_existing_management_users_keep_access_after_migration(): void
+    {
+        // Kondisi sebelum Modul 0b: role management memegang permission fungsi lewat role.
+        $legacy = ['manage users', 'verify registrations', 'manage invoices', 'confirm payments', 'view finance reports', 'manage branches', 'manage programs'];
+        Role::findByName('management')->givePermissionTo($legacy);
+        $user = User::create(['name' => 'Lama', 'email' => 'lama@test.id', 'password' => Hash::make('password'), 'is_active' => true]);
+        $user->assignRole('management');
+        $trainer = $this->makeStaff('trainer');
+
+        (require database_path('migrations/2026_10_28_110000_grant_function_permissions_to_existing_management_users.php'))->up();
+
+        $this->seedRoles(); // role management dibersihkan dari permission fungsi
+        $user = $user->fresh();
+        $this->assertEqualsCanonicalizing($legacy, $user->getDirectPermissions()->pluck('name')->all());
+        $this->assertTrue($user->can('manage users'));
+        $this->assertSame([], $trainer->fresh()->getDirectPermissions()->pluck('name')->all());
+    }
+}
